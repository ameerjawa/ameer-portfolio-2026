{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/projects/layout,_N_T_/projects/[slug]/layout,_N_T_/projects/[slug]/page,_N_T_/projects/teachme-tutoring-app"}},"html":"<!DOCTYPE html><!--N621_7NQ4sJ7c84Zdr1bO--><html lang=\"en\" class=\"dark __variable_f367f3 __variable_3c557b\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/bb3ef058b751a6ad-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/e4af272ccee01ff0-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/css/cae17e3e378cd9b6.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-d4aaeb6037c08974.js\"/><script src=\"/_next/static/chunks/4bd1b696-cf72ae8a39fa05aa.js\" async=\"\"></script><script src=\"/_next/static/chunks/964-9e7fd12428968086.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-c22a33fea5884d89.js\" async=\"\"></script><script src=\"/_next/static/chunks/872-6a7681980fdd4a63.js\" async=\"\"></script><script src=\"/_next/static/chunks/598-9120f3ee076ac4cd.js\" async=\"\"></script><script src=\"/_next/static/chunks/698-4fb8bc7e34d62197.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-78146ca89600398e.js\" async=\"\"></script><script src=\"/_next/static/chunks/350-f341f76e4e6466ef.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/projects/%5Bslug%5D/page-25471ac655b13bc7.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>TeachMe — Tutoring &amp; Learning App — Ameer Jawabra — Ameer Jawabra</title><meta name=\"description\" content=\"A cross-platform tutoring application connecting students with teachers, courses, level exams, and scheduled lessons.\"/><meta na