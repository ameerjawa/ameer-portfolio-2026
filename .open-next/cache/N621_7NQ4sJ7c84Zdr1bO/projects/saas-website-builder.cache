{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/projects/layout,_N_T_/projects/[slug]/layout,_N_T_/projects/[slug]/page,_N_T_/projects/saas-website-builder"}},"html":"<!DOCTYPE html><!--N621_7NQ4sJ7c84Zdr1bO--><html lang=\"en\" class=\"dark __variable_f367f3 __variable_3c557b\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/bb3ef058b751a6ad-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/e4af272ccee01ff0-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/css/cae17e3e378cd9b6.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-d4aaeb6037c08974.js\"/><script src=\"/_next/static/chunks/4bd1b696-cf72ae8a39fa05aa.js\" async=\"\"></script><script src=\"/_next/static/chunks/964-9e7fd12428968086.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-c22a33fea5884d89.js\" async=\"\"></script><script src=\"/_next/static/chunks/872-6a7681980fdd4a63.js\" async=\"\"></script><script src=\"/_next/static/chunks/598-9120f3ee076ac4cd.js\" async=\"\"></script><script src=\"/_next/static/chunks/698-4fb8bc7e34d62197.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-78146ca89600398e.js\" async=\"\"></script><script src=\"/_next/static/chunks/350-f341f76e4e6466ef.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/projects/%5Bslug%5D/page-25471ac655b13bc7.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>SaaS Website Builder Platform — Ameer Jawabra — Ameer Jawabra</title><meta name=\"description\" content=\"A multi-tenant website-builder enabling non-technical users to launch production sites with custom themes, domains, and content.\"/><meta name=\"author\" content=\"Ameer Jawabra\"/><meta name=\"keywords\" content=\"Ameer Jawabra,Full Stack Software Engineer,Full Stack Developer,React Developer,Next.js Developer,Node.js Developer,TypeScript Developer,Software Engineer\"/><meta name=\"creator\" content=\"Ameer Jawabra\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-image-preview:large\"/><link rel=\"canonical\" href=\"https://ameerjawabra.dev\"/><meta property=\"og:title\" content=\"SaaS Website Builder Platform — Ameer Jawabra\"/><meta property=\"og:description\" content=\"A multi-tenant website-builder enabling non-technical users to launch production sites with custom themes, domains, and content.\"/><meta property=\"og:url\" content=\"https://ameerjawabra.dev/projects/saas-website-builder\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"SaaS Website Builder Platform — Ameer Jawabra\"/><meta name=\"twitter:description\" content=\"A multi-tenant website-builder enabling non-technical users to launch production sites with custom themes, domains, and content.\"/><link rel=\"icon\" href=\"/favicon.png\"/><link rel=\"apple-touch-icon\" href=\"/favicon.png\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans bg-background text-foreground\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:border focus:border-border focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:text-foreground\">Skip to content</a><header class=\"fixed inset-x-0 top-0 z-50\"><div class=\"transition-all duration-300 border-b border-transparent bg-transparent\"><nav class=\"mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-5 sm:px-8\"><a class=\"group flex items-center gap-2.5\" aria-label=\"Ameer Jawabra — home\